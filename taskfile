#!/bin/bash

# Check for -debug flag
if [[ $* == *-debug* ]]; then
    set -x
fi

export LGR_NO_TIMESTAMP=true

GIT_MAIN="main"
VERSION_FILE="./.version"

# If we have a .taskenv file load it as source
if [ -f .taskenv ]; then
    # shellcheck disable=SC1091
    source .taskenv
fi

# This makes all bin packages installed via npm available here
# e.g. bogota, nyc, autocannon, etc.
PATH=$(pwd)/node_modules/.bin:$PATH

# This will make all scripts available in the ./src/bin directory
PATH=$(pwd)/src/bin:$PATH

TYPESENSE_IMAGE="${TYPESENSE_IMAGE:-typesense/typesense:0.25.2}"
TYPESENSE_CONTAINER_NAME="${TYPESENSE_CONTAINER_NAME:-go-search-typesense}"
TYPESENSE_DATA_DIR="${TYPESENSE_DATA_DIR:-$(pwd)/.tmp/typesense-data}"
TYPESENSE_PORT="${TYPESENSE_PORT:-8108}"
TYPESENSE_PROTOCOL="${TYPESENSE_PROTOCOL:-http}"
TYPESENSE_API_KEY="${GO_SEARCH_TEST_TYPESENSE_API_KEY:-${TYPESENSE_API_KEY:-xyz}}"
TYPESENSE_URL="${GO_SEARCH_TEST_TYPESENSE_URL:-${TYPESENSE_PROTOCOL}://localhost:${TYPESENSE_PORT}}"


#################################################
# Development dependencies
#################################################

function _install:lgr {
    mkdir -p bin
    if hash lgr 2>/dev/null; then
        lgr OK "lgr already installed..."
    else
        echo "Installing lgr"
        brew tap goliatone/homebrew-tap
        brew install lgr
        lgr OK "lgr installed..."
    fi
}

function _install:changelog {
    if git-cliff lgr 2>/dev/null; then
        lgr OK "git-cliff already installed..."
    else
        echo "Installing lgr"
        brew install brew install orhun/git-cliff/git-cliff
        lgr OK "git-cliff installed..."
    fi
}

function _install:brew {
    if [[ $(command -v brew) == "" ]]; then
        lgr I "Installing Hombrew"
        /usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
    else
        lgr I "Updating Homebrew"
        brew update
    fi
}

function _install:envset {
    if hash envset 2>/dev/null; then
        lgr OK "envset installed..."
    else
        lgr I "Installing envset..."
        brew install envset
        lgr OK "envset installed..."
    fi
}

##########################################
# Application management
##########################################

function dev:install {
    cd "$(pwd)/src" || exit "$?"

    _install:lgr
    _install:brew

    _install:envset
    _install:changelog

    lgr ok "dependencies intalled..."
}

function dev:env:load {
    eval "$(envset development --isolated=true)"
}

function dev:test {
    go test ./...
}

function dev:test:release:fast {
    go test ./... || return 1
    (
        cd examples/search-shell || exit 1
        ./taskfile dev:test
    ) || return 1
    (
        cd examples/search-shell || exit 1
        ./taskfile release:validate
    ) || return 1
}

function dev:test:release:parity {
    (
        cd examples/search-shell || exit 1
        ./taskfile release:validate:parity
    )
}

function dev:test:release:full {
    (
        cd ../go-i18n || exit 1
        go test ./...
    ) || return 1

    go test ./... || return 1

    (
        cd examples/search-shell || exit 1
        ./taskfile dev:test
    ) || return 1

    (
        cd examples/search-shell || exit 1
        ./taskfile release:validate:full
    ) || return 1

    (
        cd ../go-admin || exit 1
        go test ./admin ./quickstart/site ./examples/web
    ) || return 1

    (
        cd ../go-cms || exit 1
        go test ./content ./internal/pages
    ) || return 1

    (
        cd ../go-users || exit 1
        go test ./service ./query ./activity
    ) || return 1
}

function dev:test:adapters {
    local dir

    for dir in adapters/goadmin adapters/gocms adapters/gousers; do
        if [ -f "${dir}/go.mod" ]; then
            (cd "${dir}" && go test ./...) || return 1
        fi
    done
}

function dev:cover {
    go test -coverprofile=coverage.out ./... && go tool cover -func coverage.out
}

function dev:ts:init {
    if ! command -v docker >/dev/null 2>&1; then
        lgr ERR "docker is required"
        return 1
    fi

    mkdir -p "${TYPESENSE_DATA_DIR}"

    if docker container inspect "${TYPESENSE_CONTAINER_NAME}" >/dev/null 2>&1; then
        lgr OK "typesense container already initialized: ${TYPESENSE_CONTAINER_NAME}"
    else
        lgr I "pulling ${TYPESENSE_IMAGE}"
        docker pull "${TYPESENSE_IMAGE}" || return 1

        lgr I "creating ${TYPESENSE_CONTAINER_NAME}"
        docker create \
            --name "${TYPESENSE_CONTAINER_NAME}" \
            --publish "${TYPESENSE_PORT}:8108" \
            --env "TYPESENSE_API_KEY=${TYPESENSE_API_KEY}" \
            --env "TYPESENSE_DATA_DIR=/data" \
            --mount "type=bind,src=${TYPESENSE_DATA_DIR},dst=/data" \
            "${TYPESENSE_IMAGE}" \
            --data-dir /data \
            --api-key "${TYPESENSE_API_KEY}" \
            --enable-cors || return 1
    fi

    lgr I "typesense url: ${TYPESENSE_URL}"
    lgr I "typesense api key: ${TYPESENSE_API_KEY}"
    lgr I "test env: GO_SEARCH_TEST_TYPESENSE_URL=${TYPESENSE_URL} GO_SEARCH_TEST_TYPESENSE_API_KEY=${TYPESENSE_API_KEY}"
}

function dev:ts:run {
    if ! command -v docker >/dev/null 2>&1; then
        lgr ERR "docker is required"
        return 1
    fi

    if ! docker container inspect "${TYPESENSE_CONTAINER_NAME}" >/dev/null 2>&1; then
        dev:ts:init || return 1
    fi

    if [ "$(docker inspect -f '{{.State.Running}}' "${TYPESENSE_CONTAINER_NAME}" 2>/dev/null)" = "true" ]; then
        lgr OK "typesense container already running: ${TYPESENSE_CONTAINER_NAME}"
    else
        lgr I "starting ${TYPESENSE_CONTAINER_NAME}"
        docker start "${TYPESENSE_CONTAINER_NAME}" >/dev/null || return 1
    fi

    lgr I "typesense url: ${TYPESENSE_URL}"
    lgr I "typesense api key: ${TYPESENSE_API_KEY}"
}

function dev:ts:reset {
    if ! command -v docker >/dev/null 2>&1; then
        lgr ERR "docker is required"
        return 1
    fi

    if docker container inspect "${TYPESENSE_CONTAINER_NAME}" >/dev/null 2>&1; then
        if [ "$(docker inspect -f '{{.State.Running}}' "${TYPESENSE_CONTAINER_NAME}" 2>/dev/null)" = "true" ]; then
            lgr I "stopping ${TYPESENSE_CONTAINER_NAME}"
            docker stop "${TYPESENSE_CONTAINER_NAME}" >/dev/null || return 1
        fi

        lgr I "removing ${TYPESENSE_CONTAINER_NAME}"
        docker rm "${TYPESENSE_CONTAINER_NAME}" >/dev/null || return 1
    fi

    lgr I "removing ${TYPESENSE_DATA_DIR}"
    rm -rf "${TYPESENSE_DATA_DIR}"

    dev:ts:init
}


function go:mod:update {
    local modules
    local extra=()
    local mod
    local root
    local latest
    local root_latest
    local resolved
    local current_mod

    if ! command -v rg >/dev/null 2>&1; then
        lgr ERR "rg is required to list goliatone modules"
        return 1
    fi

    # Get current module name to exclude from updates (avoid self-update and submodules)
    current_mod=$(go list -m)

    modules=$(rg -o 'github.com/goliatone/[^[:space:]]+' go.mod | sort -u | grep -v "^${current_mod}")
    if [ -z "$modules" ]; then
        lgr ERR "no goliatone modules found in go.mod"
        return 1
    fi

    lgr I "updating goliatone modules to latest..."
    for mod in $modules; do
        latest=""
        resolved=0
        if latest=$(go list -m -u -f '{{if .Update}}{{.Update.Version}}{{else}}{{.Version}}{{end}}' "$mod" 2>/dev/null); then
            resolved=1
        fi

        if [ "$resolved" -eq 1 ] && [ -n "$latest" ]; then
            lgr I "go get ${mod}@${latest}"
            go get "${mod}@${latest}" || return 1
            continue
        fi

        lgr WARN "failed to resolve latest for ${mod}, trying ${mod}@latest"
        if go get -u "${mod}@latest"; then
            continue
        fi

        root=$(echo "$mod" | awk -F/ '{print $1"/"$2"/"$3}')
        if [ "$root" != "$mod" ]; then
            root_latest=""
            if root_latest=$(go list -m -u -f '{{if .Update}}{{.Update.Version}}{{else}}{{.Version}}{{end}}' "$root" 2>/dev/null); then
                lgr WARN "failed to update ${mod}, retrying ${root}@${root_latest}"
                go get "${root}@${root_latest}" || return 1
            else
                lgr WARN "failed to resolve ${root}, retrying ${root}@latest"
                go get -u "${root}@latest" || return 1
            fi
        else
            return 1
        fi
    done

    if [ "$#" -gt 0 ]; then
        for mod in "$@"; do
            extra+=("${mod}@latest")
        done
        lgr I "updating extra modules: ${extra[*]}"
        go get -u "${extra[@]}" || return 1
    fi

    go mod tidy
}


##
## ########################################
##           Version Management
## ########################################

##
## -----
##
## version:upsert
##
## Save version to meta file.
## First time will create file if not present
##
## Arguments:
## @arg 1 {string} [tag=0.0.1]
function version:upsert {
    local tag=${1}

    if [ -z "$tag" ]; then
        version:get
    else
        version:set "$tag"
        version:get
    fi
}

##
## -----
##
## version:get
##
## Get version from meta file.
function version:get {

    test -f "${VERSION_FILE}" || touch "${VERSION_FILE}"

    local tag
    tag=$(cat "${VERSION_FILE}")

    if [ -z "$tag" ]; then
        tag="0.0.1"
        version:set "$tag"
    fi

    echo -n "$tag"
}

##
## -----
##
## version:set
##
## Set and save version to meta file.
## First time will create file if not present.
##
## Arguments:
## @arg 1 {string} [tag=0.0.1]
function version:set {

    local tag
    tag=${1}
    if [ -z "$tag" ]; then
        exit 1
    fi

    version:check

    echo -e "$tag" > "${VERSION_FILE}"
}

##
## -----
##
## version:bump
## Bump sem ver by specifying a level.
## Valid levels are:
## - patch (default)
## - minor
## - major
##
## If you want to update the .version file
## pass the `--write` flag.
## @see https://github.com/fsaintjacques/semver-tool/blob/master/src/semver
##
## @arg 1 {string} [level=patch]
## Outputs:
##   Semver string "$major.$minor.$patch"
##
## @flag --write Will write to .version file
##
function version:bump {

    version:check

    # Default values
    level='patch'
    write_to_file=0

    # Parse options
    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --write)
                write_to_file=1
                shift
            ;;
            patch|minor|major)
                level=$1
                shift
            ;;
            *)
                echo "Invalid option: $1"
                return 2
            ;;
        esac
    done

    # Read contents of version and store in
    IFS='.' read -ra identifiers < "$VERSION_FILE"

    [[ "${#identifiers[@]}" -ne 3 ]] && echo "Invalid semver string" && return 1

    patch=${identifiers[2]}
    minor=${identifiers[1]}
    major=${identifiers[0]}

    case $level in
        patch)
            patch=$((patch+1))
        ;;
        minor)
            minor=$((minor+1))
            patch=0
        ;;
        major)
            major=$((major+1))
            minor=0
            patch=0
        ;;
        *)
            echo "Invalid level passed"
            return 2
    esac

    new_version="$major.$minor.$patch"

    if [[ $write_to_file -eq 1 ]]; then
        echo "$new_version" > "${VERSION_FILE}"
    else
        echo "$new_version"
    fi
}

function version:check {
    if [ ! -f "$VERSION_FILE" ]; then
        echo "0.0.0" > "$VERSION_FILE"
    fi
}


##
## -----
##
## adapters:*:sync
##
## Keep nested adapter modules in sync with the root go-search release tag.
##
## Arguments:
## @arg 1 {string} tag
## @flag --tidy Run go mod tidy (use after tag is published)
function _adapters:sync_go_search {
    local dir=${1}
    local tag=${2}
    shift 2

    local run_tidy=0
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --tidy)
                run_tidy=1
            ;;
        esac
        shift
    done

    if [ -z "${dir}" ] || [ -z "${tag}" ]; then
        exit 1
    fi

    if [ ! -f "${dir}/go.mod" ]; then
        return 0
    fi

    (cd "${dir}" && go mod edit -require=github.com/goliatone/go-search@v${tag})

    if [ "$run_tidy" -eq 1 ]; then
        (cd "${dir}" && go mod tidy)
    fi
}

function adapters:goadmin:sync {
    local tag=${1}
    shift
    _adapters:sync_go_search "adapters/goadmin" "${tag}" "$@"
}

function adapters:gocms:sync {
    local tag=${1}
    shift
    _adapters:sync_go_search "adapters/gocms" "${tag}" "$@"
}

function adapters:gousers:sync {
    local tag=${1}
    shift
    _adapters:sync_go_search "adapters/gousers" "${tag}" "$@"
}

function adapters:sync {
    local tag=${1}
    shift
    adapters:goadmin:sync "${tag}" "$@"
    adapters:gocms:sync "${tag}" "$@"
    adapters:gousers:sync "${tag}" "$@"
}


##
## -----
##
## release
##
## Bump our current version, create a git tag
## and push to trigger our release flow.
##
## Arguments:
## @arg 1 {string} [level=patch]
##        Accepted major, minor, patch
function release {
    local tag
    local level
    local message
    local current_branch

    current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [[ "${current_branch}" != "${GIT_MAIN}" ]]; then
        log E "Release must run on ${GIT_MAIN}; current branch is ${current_branch}"
        exit 1
    fi

    # Fetch all changes from origin
    git fetch --all
    # Make sure we have the latest version file
    git checkout origin/main -- ".version"

    # Pull tags to make sure we have
    if ! git pull --tags -f; then
        echo "error: git pull failed."
        echo "error: please resolve conflicts or stash local changes."
        exit 1
    fi

    level=${1:-"patch"}

    # Bump our version
    tag=$(version:bump "${level}")

    # Set message: default to New major|minor|patch release: vx.x.x
    message=${2:-"New ${level} release: v${tag}"}

    # Update version file
    version:set "${tag}"

    # Sync adapter modules to the new tag
    adapters:sync "${tag}"

    # Add updated version file to git
    git add "${VERSION_FILE}"
    for dir in adapters/goadmin adapters/gocms adapters/gousers; do
        if [ -f "${dir}/go.mod" ]; then
            git add "${dir}/go.mod"
            if [ -f "${dir}/go.sum" ]; then
                git add "${dir}/go.sum"
            fi
        fi
    done
    git commit -m "Bump version: v${tag}"

    # Create a new tag
    git tag -a "v${tag}" -m "${message}"
    git tag -a "adapters/goadmin/v${tag}" -m "go-admin adapter release: v${tag}"
    git tag -a "adapters/gocms/v${tag}" -m "go-cms adapter release: v${tag}"
    git tag -a "adapters/gousers/v${tag}" -m "go-users adapter release: v${tag}"

    # Push tags and trigger release 🚀 🥳
    git push --tags
    git push

    # Generate changelog
    git cliff --output CHANGELOG.md
    git add CHANGELOG.md
    git commit -m "docs: update changelog for v${tag}"

    git push
}

##########################################
# Help and auxiliary functions
##########################################

## Show function code
function help:show {
    declare -f "$1"
}

function help {
    echo ""
    echo "$0 <task> [...arguments]"
    echo ""
    echo "Project: ${PROJECT}"
    echo ""
    echo "Tasks:"
    compgen -A function | grep -v '^_' | cat -n
    echo ""

    prog="$0"
    me=$(basename "$prog")

    grep -e '^##[[:space:]]' -e '^##$' "$prog" | sed -e 's/^##//' -e "s/_PROG_/$me/" 2>&1 | less
}

TIMEFORMAT="Task completed in %3lR"
time "${@:-help}"
