# Development dependencies
#################################################

function _install:lgr {
    mkdir -p bin
    if hash lgr 2>/dev/null; then
        lgr OK "lgr already installed..."
    else
        echo "Installing lgr"
        brew tap goliatone/homebrew-tap
        brew install lgr
        lgr OK "lgr installed..."
    fi
}

function _install:changelog {
    if git-cliff lgr 2>/dev/null; then
        lgr OK "git-cliff already installed..."
    else
        echo "Installing lgr"
        brew install brew install orhun/git-cliff/git-cliff
        lgr OK "git-cliff installed..."
    fi
}

function _install:brew {
    if [[ $(command -v brew) == "" ]]; then
        lgr I "Installing Hombrew"
        /usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
    else
        lgr I "Updating Homebrew"
        brew update
    fi
}

function _install:envset {
    if hash envset 2>/dev/null; then
        lgr OK "envset installed..."
    else
        lgr I "Installing envset..."
        brew install envset
        lgr OK "envset installed..."
    fi
}

function _go:bin {
    if command -v go >/dev/null 2>&1; then
        command -v go
        return 0
    fi

    echo "go binary not found in PATH" >&2
    return 1
}

function _go:quality:prepare_env {
    export GOCACHE="${GOCACHE:-${GO_QUALITY_GOCACHE}}"
    export GOTMPDIR="${GOTMPDIR:-${GO_QUALITY_GOTMPDIR}}"
    mkdir -p "${GOCACHE}" "${GOTMPDIR}"
}

function _go:golangci_lint_version {
    if [ -f "${GO_GOLANGCI_LINT_VERSION_FILE}" ]; then
        awk 'NF { print $1; exit }' "${GO_GOLANGCI_LINT_VERSION_FILE}"
        return 0
    fi

    printf '%s\n' "${GO_GOLANGCI_LINT_VERSION}"
}

function _go:tool_bin_dir {
    local go_bin
    local gobin
    local gopath

    go_bin=$(_go:bin) || return 1
    gobin="$("${go_bin}" env GOBIN)"
    if [ -n "${gobin}" ]; then
        printf '%s\n' "${gobin}"
        return 0
    fi

    gopath="$("${go_bin}" env GOPATH)"
    if [ -n "${gopath}" ]; then
        printf '%s\n' "${gopath%/}/bin"
        return 0
    fi

    echo "unable to resolve Go tool bin directory" >&2
    return 1
}

function _go:tool:path {
    local name=$1
    local bin_dir

    if bin_dir=$(_go:tool_bin_dir 2>/dev/null); then
        if [ -x "${bin_dir}/${name}" ]; then
            printf '%s\n' "${bin_dir}/${name}"
            return 0
        fi
    fi

    if command -v "${name}" >/dev/null 2>&1; then
        command -v "${name}"
        return 0
    fi

    return 1
}

function _go:version_major_minor {
    local version=$1

    version="${version#go}"
    if [[ "${version}" =~ ^([0-9]+)\.([0-9]+) ]]; then
        printf '%s.%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        return 0
    fi

    return 1
}

function _go:version_major_minor_lt {
    local left=$1
    local right=$2
    local left_mm
    local right_mm
    local left_major
    local left_minor
    local right_major
    local right_minor

    left_mm=$(_go:version_major_minor "${left}") || return 1
    right_mm=$(_go:version_major_minor "${right}") || return 1

    left_major="${left_mm%%.*}"
    left_minor="${left_mm#*.}"
    right_major="${right_mm%%.*}"
    right_minor="${right_mm#*.}"

    if (( left_major < right_major )); then
        return 0
    fi
    if (( left_major == right_major && left_minor < right_minor )); then
        return 0
    fi

    return 1
}

function _go:current_go_version {
    local go_bin

    go_bin=$(_go:bin) || return 1
    GOTOOLCHAIN="${GO_TOOLCHAIN}" "${go_bin}" env GOVERSION
}

function _go:tool:build_go_version {
    local tool_path=$1
    local go_bin

    go_bin=$(_go:bin) || return 1
    "${go_bin}" version -m "${tool_path}" 2>/dev/null | awk 'NR == 1 { print $NF }'
}

function _go:tool:needs_rebuild_for_go {
    local name=$1
    local tool_path=$2
    local current_go
    local tool_go

    current_go=$(_go:current_go_version) || return 1
    tool_go=$(_go:tool:build_go_version "${tool_path}") || return 1

    if [ -z "${tool_go}" ]; then
        return 1
    fi

    if _go:version_major_minor_lt "${tool_go}" "${current_go}"; then
        echo "${name} was built with ${tool_go}; rebuilding with ${current_go}" >&2
        return 0
    fi

    return 1
}

function _go:tool:install {
    local name=$1
    local target=$2
    local go_bin

    go_bin=$(_go:bin) || return 1
    _go:quality:prepare_env || return 1
    echo "Installing ${name} (${target})" >&2
    GOTOOLCHAIN="${GO_TOOLCHAIN}" "${go_bin}" install "${target}" || return 1
    _go:tool:path "${name}" || return 1
}

function _go:tool:ensure {
    local name=$1
    local target=$2
    local tool_path

    if tool_path=$(_go:tool:path "${name}" 2>/dev/null); then
        if _go:tool:needs_rebuild_for_go "${name}" "${tool_path}"; then
            _go:tool:install "${name}" "${target}"
            return $?
        fi

        printf '%s\n' "${tool_path}"
        return 0
    fi

    _go:tool:install "${name}" "${target}"
}

function _go:module_dirs {
    local module
    for module in ${GO_QUALITY_MODULES}; do
        printf '%s\n' "${module}"
    done
}

function _go:module_key {
    local module=$1

    if [ "${module}" = "." ]; then
        printf 'root\n'
        return 0
    fi

    printf '%s\n' "${module//\//__}"
}

function _go:baseline_path {
    local module=$1
    local tool=$2
    local module_key

    module_key=$(_go:module_key "${module}") || return 1
    printf '%s/%s/%s.txt\n' "${GO_QUALITY_BASELINE_DIR}" "${module_key}" "${tool}"
}

function _go:packages {
    local module_dir=$1
    shift
    local go_bin
    local -a patterns=()

    go_bin=$(_go:bin) || return 1
    if [ "$#" -gt 0 ]; then
        patterns=("$@")
    else
        patterns=("./...")
    fi

    (
        cd "${module_dir}" || exit 1
        "${go_bin}" list "${patterns[@]}"
    )
}

function _go:package_dirs {
    local module_dir=$1
    shift
    local go_bin
    local -a patterns=()

    go_bin=$(_go:bin) || return 1
    if [ "$#" -gt 0 ]; then
        patterns=("$@")
    else
        patterns=("./...")
    fi

    (
        cd "${module_dir}" || exit 1
        "${go_bin}" list -f '{{.Dir}}' "${patterns[@]}"
    )
}

function _go:files {
    find . -type f -name '*.go' \
        -not -path './.git/*' \
        -not -path './.gocache/*' \
        -not -path './.tmp/*' \
        -not -path './node_modules/*' \
        -not -path './vendor/*' \
        | sort
}

function _go:for_each_module {
    local callback=$1
    shift
    local module

    while IFS= read -r module; do
        if [ -n "${module}" ]; then
            "${callback}" "${module}" "$@" || return 1
        fi
    done < <(_go:module_dirs)
}

function _go:packages_for_module {
    local module=$1
    shift
    local -a packages=()
    local pkg

    while IFS= read -r pkg; do
        if [ -n "${pkg}" ]; then
            packages+=("${pkg}")
        fi
    done < <(_go:packages "${module}" "$@")

    printf '%s\0' "${packages[@]}"
}

function _go:package_dirs_for_module {
    local module=$1
    shift
    local -a dirs=()
    local dir

    while IFS= read -r dir; do
        if [ -n "${dir}" ]; then
            dirs+=("${dir}")
        fi
    done < <(_go:package_dirs "${module}" "$@")

    printf '%s\0' "${dirs[@]}"
}

function _go:test_module {
    local module=$1
    shift
    local go_bin
    local -a packages=()

    go_bin=$(_go:bin) || return 1
    _go:quality:prepare_env || return 1
    while IFS= read -r -d '' pkg; do
        packages+=("${pkg}")
    done < <(_go:packages_for_module "${module}" "$@")
    if [ "${#packages[@]}" -eq 0 ]; then
        return 0
    fi

    echo "==> go:test (${module})"
    (
        cd "${module}" || exit 1
        "${go_bin}" test "${packages[@]}"
    )
}

