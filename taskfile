function _go:lint:golangci:run_module {
    local module=$1
    local label=$2
    shift 2
    local version
    local golangci_lint_bin
    local -a run_args=()
    local -a patterns=()

    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
        run_args+=("$1")
        shift
    done

    if [ "$#" -gt 0 ] && [ "$1" = "--" ]; then
        shift
    fi

    version="$(_go:golangci_lint_version)" || return 1
    golangci_lint_bin=$(_go:tool:ensure "golangci-lint" "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${version}") || return 1
    _go:quality:prepare_env || return 1
    if [ "$#" -gt 0 ]; then
        patterns=("$@")
    else
        patterns=("./...")
    fi

    echo "==> ${label} (${module})"
    (
        cd "${module}" || exit 1
        "${golangci_lint_bin}" run "${run_args[@]}" "${patterns[@]}"
    )
}

function _go:lint_module {
    local module=$1
    shift

