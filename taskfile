#!/bin/bash

# Check for -debug flag
if [[ $* == *-debug* ]]; then
    set -x
fi

export LGR_NO_TIMESTAMP=true

GIT_MAIN="main"
VERSION_FILE="./.version"
PROJECT_ROOT="$(pwd)"

# If we have a .taskenv file load it as source
if [ -f .taskenv ]; then
    # shellcheck disable=SC1091
    source .taskenv
fi

# This makes all bin packages installed via npm available here
# e.g. bogota, nyc, autocannon, etc.
PATH=$(pwd)/node_modules/.bin:$PATH

# This will make all scripts available in the ./src/bin directory
PATH=$(pwd)/src/bin:$PATH

TYPESENSE_IMAGE="${TYPESENSE_IMAGE:-typesense/typesense:0.25.2}"
TYPESENSE_CONTAINER_NAME="${TYPESENSE_CONTAINER_NAME:-go-search-typesense}"
TYPESENSE_DATA_DIR="${TYPESENSE_DATA_DIR:-$(pwd)/.tmp/typesense-data}"
TYPESENSE_PORT="${TYPESENSE_PORT:-8108}"
TYPESENSE_PROTOCOL="${TYPESENSE_PROTOCOL:-http}"
TYPESENSE_API_KEY="${GO_SEARCH_TEST_TYPESENSE_API_KEY:-${TYPESENSE_API_KEY:-xyz}}"
TYPESENSE_URL="${GO_SEARCH_TEST_TYPESENSE_URL:-${TYPESENSE_PROTOCOL}://localhost:${TYPESENSE_PORT}}"
GO_TOOLCHAIN="${GO_TOOLCHAIN:-local}"
GO_GOLANGCI_LINT_VERSION="${GO_GOLANGCI_LINT_VERSION:-v2.11.3}"
GO_GOLANGCI_LINT_VERSION_FILE="${GO_GOLANGCI_LINT_VERSION_FILE:-.golangci-lint-version}"
GO_STATICCHECK_VERSION="${GO_STATICCHECK_VERSION:-v0.7.0}"
GO_GOVULNCHECK_VERSION="${GO_GOVULNCHECK_VERSION:-v1.1.4}"
GO_GOSEC_VERSION="${GO_GOSEC_VERSION:-v2.25.0}"
GO_QUALITY_BASELINE_DIR="${GO_QUALITY_BASELINE_DIR:-${PROJECT_ROOT}/ops/quality/baselines}"
GO_QUALITY_BASELINE_SCRIPT="${GO_QUALITY_BASELINE_SCRIPT:-${PROJECT_ROOT}/tools/quality/baseline.sh}"
GO_QUALITY_GOCACHE="${GO_QUALITY_GOCACHE:-${PROJECT_ROOT}/.tmp/go-cache}"
GO_QUALITY_GOTMPDIR="${GO_QUALITY_GOTMPDIR:-${PROJECT_ROOT}/.tmp/go-tmp}"
GO_LINT_NEW_FROM_REV="${GO_LINT_NEW_FROM_REV:-origin/main}"
GO_QUALITY_MODULES="${GO_QUALITY_MODULES:-. adapters/goadmin adapters/gocms adapters/gousers examples/search-shell}"


