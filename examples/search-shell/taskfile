#!/usr/bin/env bash

set -u

EXAMPLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GO_BIN="${GO_BIN:-$(command -v go 2>/dev/null || true)}"

function _ensure:go {
    if [ -z "${GO_BIN}" ] || [ ! -x "${GO_BIN}" ]; then
        echo "Go binary not found. Set GO_BIN or install go."
        return 1
    fi
}

function dev:serve {
    _ensure:go || return 1
    (
        cd "${EXAMPLE_DIR}" || exit 1
        "${GO_BIN}" run ./cmd/demo
    )
}

function dev:test {
    _ensure:go || return 1
    (
        cd "${EXAMPLE_DIR}" || exit 1
        "${GO_BIN}" test ./...
    )
}

function dev:fmt {
    _ensure:go || return 1
    (
        cd "${EXAMPLE_DIR}" || exit 1
        "${GO_BIN}" fmt ./...
    )
}

function dev:tidy {
    _ensure:go || return 1
    (
        cd "${EXAMPLE_DIR}" || exit 1
        "${GO_BIN}" mod tidy
    )
}

function release:validate {
    _ensure:go || return 1
    (
        cd "${EXAMPLE_DIR}" || exit 1
        "${GO_BIN}" test ./release -run 'TestSearchV1ReleaseChecklistTemplateRemainsPending|TestApprovedSearchV1ReleaseChecklistSampleValidates|TestRunSearchV1RuntimeValidationProfileMemory|TestRunSearchV1RouteValidationProfileDefaultConfig|TestRunSearchV1RouteValidationProfileEditorialDisabled' -count=1
    )
}

function release:validate:parity {
    _ensure:go || return 1
    (
        cd "${EXAMPLE_DIR}" || exit 1
        GO_SEARCH_RELEASE_REQUIRE_EXTERNAL=true "${GO_BIN}" test ./release -run 'TestRunSearchV1RuntimeValidationProfileExternalProviders' -count=1
    )
}

function release:validate:full {
    _ensure:go || return 1
    (
        cd "${EXAMPLE_DIR}" || exit 1
        GO_SEARCH_RELEASE_REQUIRE_EXTERNAL=true "${GO_BIN}" test ./release -count=1
    )
}

function help {
    echo ""
    echo "$0 <task>"
    echo ""
    echo "Tasks:"
    echo "  dev:serve"
    echo "  dev:test"
    echo "  dev:fmt"
    echo "  dev:tidy"
    echo "  release:validate"
    echo "  release:validate:parity"
    echo "  release:validate:full"
    echo ""
}

"${@:-help}"
